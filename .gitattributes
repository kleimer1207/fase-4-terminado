# primero vamos a crear el codigo para saber con exactitud la hora y fecha:

from datetime import datetime
def registrar_evento (tipo,  mensaje):
    momento = datetime.now() .strftime ("%Y-%M-%D %H:%M:%S")

# ya que creamos el codigo necesario para mostrar lo que queremos vamos a mostrarselo al usuario:

    linea = f"[{momento}] [{tipo}] {mensaje}\n"

# lo siguiente es poder guardar la informacion que vayamos resiviendo y con ayuda del parametro "a" podemos hacer que la informacion se vaya almacenando:
# el parametro de encoding que usaremos sirve para que las palabras que lleven tilde o ñ salgan sin errores:

    with open ("registro_software_fj.log", "a", encoding = "utf-8") as archivo:
        archivo.write (linea)

# ahora vamos a crear las clases de los errores:

class ErrorSistemaFJ (Exception):
    pass

# python detecta al exception como un error, entonce al ponerselo a la clase de ErrorSistemFJ le estamos diciendo a python que esa clase es un error:
# ahora creamos la siguiente clase heredandole el error que ya creamos:

class ErrorValidacion (ErrorSistemaFJ):
    pass

# ahora vamos a crear una funcion con el def para la validaciond de la edad:

def validar_edad (edad):
    if edad < 18:
        raise ErrorValidacion ("la edad debe ser igual o mayor a 18 años")
        return True
    
# despues de crear el def podemos usarlo en el try:

