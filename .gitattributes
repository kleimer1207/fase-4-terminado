# lo siguiente es crear una clase abstracta:

from abc import ABC, abstractmethod
class EntidadSistema (ABC):
    def __init__ (self, id_entidad):
        self.id_entidad = id_entidad

    @abstractmethod 
    def mostrar_resumen (self):
        pass

# ahora voy a crear una clase hija llamada cliente que herede la clase pricipal EntidadSistema:

class Cliente (EntidadSistema):
    def __init__ (self, id_entidad, nombre, correo):
        super().__init__ (id_entidad)
        if not nombre or not nombre.strip():
            raise ErrorValidacion ("el espacio para colocar el nombre no puede estar vacio")
        self.nombre = nombre.strip()
        self.correo = correo

    @property
    def correo (self):
        return self._correo

#ahora vamos a usar el decorador de setter para que nuestro correo se pueda guardar de una forma segura:
# y tambien para poder validar que el cliente uso el @ en su correo:

    @correo.setter
    def correo (self, valor):
        if not valor or "@" not in valor:
            raise ErrorValidacion ("el correo es invalido")
        self._correo = valor.strip()

# vamos a crear un def para mostrar toda la informacion

    def mostrar_resumen (self):
        return f"Cliente [{self.id_entidad}] - [{self.nombre}] [{self.correo}]"

# y creare la clase de servicio:

class Servicio(EntidadSistema):
    def __init__(self, id_entidad, nombre_servicio, tarifa_base):
        super().__init__(id_entidad)
        if not nombre_servicio or not nombre_servicio.strip():
            raise ErrorValidacion("El nombre del servicio no puede estar vacio")
        if tarifa_base <= 0:
            raise ErrorValidacion("La tarifa base debe ser mayor que cero")
        self.nombre_servicio = nombre_servicio.strip()
        self.tarifa_base = tarifa_base

    @abstractmethod
    def calcular_costo(self, unidades):
        pass

    @abstractmethod
    def mostrar_resumen(self):
        pass

# ahora creare la subclase de la clase hija de servicio que se llame ReservaSala:
# con ayuda del condicional haremos que al cliente le salte un error cuando coloque que la capacidad de personas para la reservacion es 0:

class ReservaSala (Servicio):
    def __init__ (self, id_entidad, nombre_servicio, tarifa_base, capacidad_personas):
        super().__init__ (id_entidad, nombre_servicio, tarifa_base)
        if capacidad_personas <= 0:
            raise ErrorValidacion ("la capacidad de personas debe ser mayor a 0")
        self.capacidad_personas = capacidad_personas

# despues vamos a calcular el costo de la tarifa dependiendo de la cantidad de personas:

    def calcular_costo (self, unidades):
        if unidades <0:
            raise ErrorValidacion ("la cantidad de horas reservadas deben ser mayor a 0")
        return self.tarifa_base * unidades

# ahora vamos a crear el return que mostrara el resumen de toda la informacion:

    def mostrar_resumen (self):
        return (f"sala [{self.id_entidad}] - [{self.nombre_servicio}], capacidad: {self.capacidad_personas}")

# vamos a crear otra clase que hereda la clase de servicio:

class AlquilerEquipos (Servicio):
    def __init__ (self, id_entidad, nombre_servicio, tarifa_base, tipo_equipo):
        super().__init__ (id_entidad, nombre_servicio, tarifa_base)
        if not tipo_equipo or not tipo_equipo.strip():
            raise ErrorValidacion ("el tipo de equipo no puedo estar vacion")
        self.tipo_equipo = tipo_equipo.strip()

# creare un def para calcular el precio total con descuento:

    def calcular_costo (self, unidades, descuento = 0):
        if descuento < 0 or descuento >= 100:
            raise ErrorValidacion ("el valor del descuento dede estar entre 0 a 99")
        subtotal = self.tarifa_base * unidades 
        cantidad_descuento = subtotal * (descuento / 100)
        return subtotal - cantidad_descuento

    def mostrar_resumen (self):
        return f"equipo [{self.id_entidad}] - [{self.nombre_servicio}] tipo: [{self.tipo_equipo}]"

# a continuacion creare la tercera subclase de servicio:

class AsesoriaEspecializada (Servicio):
    def __init__ (self, id_entidad, nombre_servicio, tarifa_base, area_especializa):
        super().__init__ (id_entidad, nombre_servicio, tarifa_base)
        if not area_especializa or not area_especializa.strip():
            raise ErrorValidacion ("el area especializada no puede estar vacia")
        self.area_especializada = area_especializa.strip()

    def calcular_costo (self, unidades, impuestos):
        if unidades <= 0:
            raise ErrorValidacion ("las horas deben ser mayores a 0")
        if impuestos < 0:
            raise ErrorValidacion ("el impuesto no puede ser 0") 
        subtotal = self.tarifa_base * unidades 
        cantidad_impuestos = subtotal * (impuestos / 100)
        return subtotal + cantidad_impuestos
    def mostrar_resumen(self):
        return f"accesoria [{self.id_entidad} - [{self.nombre_servicio}] area: [{self.area_especializada}]"

    
# ahora voy a crear una nueva clase de error llamada ErrorReserva en donde es heredada por la clase ErrorSistaFJ:
# el str se usa por si la persona digita un numero, entonces con el str el sistema lo convierte en texto:

class ErrorReserva (ErrorSistemaFJ):
    pass

class Reserva:
    def __init__ (self, id_reserva, cliente, servicio, duracion):
        if not id_reserva or not str(id_reserva).strip():
            raise ErrorValidacion ("la reserva no puede estar vacia")
        if not isinstance (cliente, Cliente):
            raise ErrorValidacion ("la reserva debe tener un cliente valido")
        if not isinstance (servicio, Servicio):
            raise ErrorValidacion ("la reserva debe tener un servicio valido")
        if duracion <= 0:
            raise ErrorValidacion ("la duracion debe ser mayor a 0")
        
        self.id_reserva = str(id_reserva).strip()
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "PENDIENTE"
        self.costo_total = 0

    def confirmar(self):
        if self.estado == "CANCELADA":
            raise ErrorReserva("No se puede confirmar una reserva cancelada")
        self.estado = "CONFIRMADA"

    def cancelar(self):
        if self.estado == "PROCESADA":
            raise ErrorReserva("No se puede cancelar una reserva ya procesada")
        self.estado = "CANCELADA"

    def procesar(self, ajuste_porcentaje=0):
        if self.estado != "CONFIRMADA":
            raise ErrorReserva("Solo se pueden procesar reservas confirmadas")
        self.costo_total = self.servicio.calcular_costo(self.duracion, ajuste_porcentaje) if isinstance(self.servicio, (AlquilerEquipos, AsesoriaEspecializada)) else self.servicio.calcular_costo(self.duracion)
        self.estado = "PROCESADA"
        return self.costo_total

def ejecutar_reserva (reserva, ajuste_porcentaje=0):
        try:
            if not isinstance(reserva, Reserva):
                raise ErrorValidacion("Se espera una reserva valida")
            reserva.confirmar()
            total = reserva.procesar(ajuste_porcentaje)
        except ErrorSistemaFJ as error:
            registrar_evento("ERROR", f"Fallo al ejecutar reserva: {error}")
            raise ErrorReserva("No se pudo completar la operacion de reserva") from error
        else:
            registrar_evento("INFO", f"Reserva {reserva.id_reserva} procesada. Total: {total}")
            return total
        finally:
            registrar_evento("AUDITORIA", "Intento de ejecucion de reserva finalizado")

